# Copy this file to `.env` (which is git-ignored) and fill in values.
# Every value is optional for local startup: missing integrations are reported
# as "not_configured" by GET /api/v1/system/integrations.
# NEVER commit a real .env file and never copy these values into frontend code.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Comma-separated list of exact origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (server-side only) ---
SUPABASE_URL=
# The service-role / secret key bypasses Row Level Security. Server-side only, always.
# Paste it into backend/.env (git-ignored), never into this template.
SUPABASE_SERVICE_ROLE_KEY=

# Public, browser-safe key (sb_publishable_...). Used by authentication features.
# Never put the secret / service-role key here.
SUPABASE_PUBLISHABLE_KEY=

# --- Anthropic Claude API (server-side only) ---
ANTHROPIC_API_KEY=

# --- Embeddings for future RAG (provider is chosen separately) ---
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- Database integration tests (optional; see docs/MIGRATION_GUIDE.md) ---
# Connection string of a DEDICATED TEST database (never production). Tests that need
# it are skipped, and reported as skipped, when this is unset.
# TEST_DATABASE_URL=
# BRANDGUARD_TEST_DB_CONFIRM=this-is-a-test-database
