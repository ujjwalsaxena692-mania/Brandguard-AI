# BrandGuard AI keeps configuration per application. There is intentionally no
# shared root .env file, so secrets can never leak into the browser bundle.
#
#   backend/.env.example   -> copy to backend/.env         (server-side secrets)
#   frontend/.env.example  -> copy to frontend/.env.local  (public values only)
#
# Real .env files are git-ignored. Never commit them.
